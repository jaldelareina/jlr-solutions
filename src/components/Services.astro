---
const services = [
  {
    title: "Automatizaciones",
    description: "Optimiza y acelera procesos clave de tu negocio mediante flujos inteligentes desarrollados con n8n.",
  },
  {
    title: "Chatbots IA",
    description: "Asistentes personalizados basados en Inteligencia Artificial (Azure OpenAI, Copilot Studio, GPT).",
  },
  {
    title: "Integración entre sistemas",
    description: "Conecto herramientas, ERPs, CRMs y APIs para un flujo de datos unificado y eficiente.",
  },
  {
    title: "Consultoría tecnológica",
    description: "Análisis experto para identificar mejoras, proponer soluciones y elevar la eficiencia de tu empresa.",
  },
  {
    title: "IA aplicada al negocio",
    description: "Modelos, automatización inteligente, análisis avanzado y soluciones basadas en datos.",
  },
];
---

<style>
  section {
    padding: 80px 20px;
  }

  h2 {
    text-align: center;
    margin-bottom: 30px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    padding: 24px;
    border-radius: var(--radius);
    transition: var(--transition);
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  h3 {
    margin-bottom: 12px;
  }

  p {
    color: var(--secondary);
    line-height: 1.5;
  }
</style>

<section>
  <h2>Servicios</h2>
  <div class="grid">
    {services.map(service => (
      <div class="card">
        <h3>{service.title}</h3>
        <p>{service.description}</p>
      </div>
    ))}
  </div>
</section>
